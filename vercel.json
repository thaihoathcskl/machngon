{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/generate.js": {
      "maxDuration": 30
    },
    "api/v2-ask.js": {
      "maxDuration": 30
    },
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/generate",
      "destination": "/api/generate.js"
    },
    {
      "source": "/api/v2-ask",
      "destination": "/api/v2-ask.js"
    },
    {
      "source": "/api/((?!generate$|v2-ask$).*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|src/assets/).*)",
      "destination": "/index.html"
    }
  ]
}
